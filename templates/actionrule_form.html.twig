{#
 # Item rule form (ActionRule), on core's form components so it looks and
 # behaves like any GLPI form on 10 and 11 (header, CSRF, buttons, dates).
 #
 # Widgets core has no macro for (filters summary, field list with its picker
 # configuration, refresh script) arrive pre-rendered from PHP. The filters
 # themselves are edited in the rule's "Filters" tab (RuleFilter).
 #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set params = params ?? [] %}
{# As in core's generic_show_form: for a saved item this is what makes the
   header open the <form> (the page title is already shown above). #}
{% set no_header = no_header|default(not item.isNewItem() and not _get._in_modal|default(false)) %}

{# Pre-rendered HTML must reach the macros as safe markup, hence the captures. #}
{% set block_html %}{{ block_link|raw }}{% endset %}
{% set filters_field %}{{ filters_html|raw }}{% endset %}
{% set required_field %}{{ required_html|raw }}{% endset %}

<div class="asset">
   {{ include('components/form/header.html.twig', {'in_twig': true}) }}

   <div class="card-body d-flex flex-wrap">
      <div class="col-12 col-xxl-12 flex-column">
         <div class="d-flex flex-row flex-wrap flex-xl-nowrap">
            <div class="row flex-row align-items-start flex-grow-1" style="min-width: 0;">
               <div class="row flex-row">
                  <input type="hidden" name="{{ parent_field }}" value="{{ block_id }}" />

                  {{ fields.field('_block', block_html, block_label) }}

                  {{ fields.dropdownArrayField('itemtype', item.fields['itemtype'], itemtypes, labels.item, {
                     'rand': rand,
                  }) }}

                  {{ fields.field('_filters', filters_field, labels.filters) }}

                  {{ fields.dropdownYesNo('is_active', item.fields['is_active'], labels.active) }}

                  {{ fields.textareaField('message', message, labels.message) }}

                  {{ fields.field('required_fields', required_field, labels.required, {
                     'full_width': true,
                  }) }}

                  {{ fields.textareaField('comment', comment, labels.comment) }}
               </div>
            </div>
         </div>
      </div>
   </div>

   {{ include('components/form/buttons.html.twig') }}

   <div class="card-footer mx-n2 mb-n2">
      {{ include('components/form/dates.html.twig') }}
   </div>
</div>

{{ refresh_script|raw }}
